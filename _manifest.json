{
  "manifest_version": 2,
  "id": "yreidev.qq_suite",
  "version": "0.2.1",
  "name": "QQ 官方机器人全家桶",
  "description": "一个插件搞定：QQ 官方机器人私聊适配器、语音识别、语音合成（小米 MiMo）、联网搜索与读网页。",
  "author": {
    "name": "yreidev",
    "url": "https://github.com/yreidev"
  },
  "license": "AGPL-3.0",
  "plugin_type": "adapter",
  "urls": {
    "repository": "https://github.com/yreidev/maibot-qq-suite",
    "homepage": "https://github.com/yreidev/maibot-qq-suite",
    "documentation": "https://github.com/yreidev/maibot-qq-suite#readme",
    "issues": "https://github.com/yreidev/maibot-qq-suite/issues"
  },
  "host_application": {
    "min_version": "1.3.1",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.2",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.custom",
    "send.image",
    "component.enable",
    "component.disable"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎀"
    }
  }
}
